---
// Figure 3: how the dashboard classifies one machine. The first frame is static markup (a producing
// machine); machine-states-view.ts reads the controls and shows what ../model/machineState.ts says.
// The machine's shapes are the dash's StationIcon ones (frontend/src/ui/stationShapes.ts, ADR-0041).
import Goals from "../../../design/figure/Goals.astro";
import Controls from "../../../design/figure/Controls.astro";
import "../../../design/figure/figure.css";
import "../world.css";

const rules = [
  ["Paused", "is it paused?"],
  ["Unpowered", "no circuit, or the fuse tripped?"],
  ["Idle", "no recipe?"],
  ["Backed up", "an output slot full, or every input full with the output under 95%?"],
  ["Underfed", "the output under 95% of the set rate?"],
  ["Producing", "otherwise"],
];
---

<Goals
  goals={[
    { id: "underfed", text: "Lower the input fill and the output rate until the machine reads underfed." },
    { id: "slot", text: "Fill the output slot to back the machine up." },
    { id: "throttled", text: "Fill every input, empty the slot and drop the output under 95%: backed up, not underfed." },
    { id: "order", text: "Cut the power, then pause it, and see which rule wins." },
  ]}
/>
<figure class="fig ms" data-figure="machine-states" data-state="producing">
  <svg
    viewBox="0 0 460 250"
    data-state="producing"
    role="img"
    aria-label="One machine between its input and output gauges. Its colour and mark show the state the dashboard gives it; the list below says which rule decided."
  >
    <g class="gauge">
      <rect class="well" x="30" y="30" width="26" height="130" rx="4"></rect>
      <rect class="level" data-gauge="input" x="32" y="32" width="22" height="126" rx="3"></rect>
      <text class="lbl" x="43" y="180" text-anchor="middle">Inputs</text>
      <text class="dim" x="43" y="195" text-anchor="middle" data-input-sub>all full</text>
    </g>
    <path class="flow" data-flow-in d="M60 95 H150"></path>
    <g transform="translate(230 95) scale(4) translate(-24 -24)">
      <path class="feet" d="M12 38v4h6v-4M30 38v4h6v-4"></path>
      <rect class="housing" x="6" y="12" width="36" height="26" rx="3"></rect>
      <rect class="window" x="11" y="17" width="16" height="11" rx="1.5"></rect>
      <g data-mark="fill"><rect class="wfill" data-window-fill x="12" y="19.5" width="14" height="6" rx="1"></rect></g>
      <g data-mark="backedUp" hidden><polygon class="warn-mark" points="19,17.5 26,27.5 12,27.5"></polygon></g>
      <g data-mark="paused" hidden><rect class="pause" x="14" y="19" width="3" height="7"></rect><rect class="pause" x="20" y="19" width="3" height="7"></rect></g>
      <g data-mark="unpowered" hidden><path class="cross" d="M14 19 23 26M23 19 14 26"></path></g>
      <g data-mark="idle" hidden><path class="blank" d="M13 22.5H25"></path></g>
      <rect class="port" x="30" y="17" width="7" height="16" rx="1.5"></rect>
      <circle class="light" data-light cx="33.5" cy="21" r="1.6"></circle>
    </g>
    <!-- Mirrors the input belt: 4 from its gauge, 8 from the housing (which spans 158 to 302), so the machine sits centred. -->
    <path class="flow" data-flow-out d="M310 95 H400"></path>
    <g class="gauge">
      <rect class="well" x="404" y="30" width="26" height="130" rx="4"></rect>
      <rect class="level" data-gauge="output" x="406" y="32" width="22" height="126" rx="3"></rect>
      <line class="tick" x1="398" x2="436" y1="36.5" y2="36.5"></line>
      <text class="dim" x="392" y="40" text-anchor="end">95%</text>
      <text class="lbl" x="436" y="180" text-anchor="end">Output</text>
      <text class="dim" x="436" y="195" text-anchor="end" data-output-sub>100% of set rate</text>
    </g>
    <text class="dim status" x="230" y="232" text-anchor="middle" data-status>Power on · Recipe set · Output slot has room</text>
  </svg>
  <ol class="ms-rules" aria-label="The dashboard checks these in order; the first yes decides." data-ready-mark>
    {
      rules.map(([name, q], i) => (
        <li data-rule class={i === 5 ? "hit" : "no"}>
          <b>{name}</b> <span>{q}</span>{" "}
          <span class="verdict" data-verdict>
            {i === 5 ? "yes" : "no"}
          </span>
        </li>
      ))
    }
  </ol>
  <Controls label="Machine controls" speed={false} play={false}>
    <label class="ms-slider"><span>Ingredients in stock</span><input class="fig-range" type="range" min="0" max="100" step="1" value="100" data-ctl="input" /></label>
    <label class="ms-slider"><span>Output vs. set rate</span><input class="fig-range" type="range" min="0" max="100" step="1" value="100" data-ctl="output" /></label>
    <button class="fig-tbtn" type="button" data-ctl="slot" aria-pressed="false">Output slot full</button>
    <button class="fig-tbtn" type="button" data-ctl="power" aria-pressed="false">Cut power</button>
    <button class="fig-tbtn" type="button" data-ctl="paused" aria-pressed="false">Pause</button>
    <button class="fig-tbtn" type="button" data-ctl="recipe" aria-pressed="false">Clear recipe</button>
  </Controls>
  <p class="fig-caption" aria-live="polite">Inputs are in and the output runs at the set rate: producing.</p>
  <p class="fig-limit" data-limit hidden>Limit: a fluid input has no slot, so it never counts as full. An output-throttled refinery still reads underfed.</p>
</figure>

<script>
  import { whenVisible } from "../../../design/figure/lazy";
  for (const el of document.querySelectorAll<HTMLElement>('figure[data-figure="machine-states"]')) {
    whenVisible(el, () => {
      void import("./machine-states-view").then((m) => m.mount(el));
    });
  }
</script>

<style>
  .ms {
    --st: var(--satis-ok);
  }
  .ms[data-state="underfed"] {
    --st: var(--satis-info);
  }
  .ms[data-state="backedUp"] {
    --st: var(--satis-warn);
  }
  .ms[data-state="unpowered"] {
    --st: var(--satis-error);
  }
  .ms[data-state="paused"],
  .ms[data-state="idle"] {
    --st: var(--satis-dim);
  }
  .ms [hidden] {
    display: none;
  }
  .ms svg {
    font-family: var(--font-text);
  }
  .ms .lbl {
    fill: var(--satis-ink);
    font-size: 13px;
    font-weight: 600;
  }
  .ms .dim {
    fill: var(--satis-dim);
    font-size: 11.5px;
  }
  .ms .status {
    font-size: 12px;
  }
  .ms .well {
    fill: var(--satis-zone-pc);
    stroke: var(--satis-line);
    stroke-width: 1.5;
  }
  .ms .level {
    fill: var(--satis-route);
    transform-box: fill-box;
    transform-origin: bottom;
    transition: transform var(--dur) var(--ease-in-out);
  }
  .ms .tick {
    stroke: var(--satis-ink);
    stroke-width: 1.5;
    stroke-dasharray: 3 2;
  }
  .ms .flow {
    stroke: var(--satis-route);
    stroke-width: 3;
    transition: opacity var(--dur) var(--ease-out);
  }
  .ms .flow.off {
    opacity: 0.25;
  }
  .ms .feet,
  .ms .housing,
  .ms .port {
    fill: var(--satis-steel-2);
    stroke: var(--satis-line);
    stroke-width: 0.7;
  }
  .ms .feet {
    fill: none;
  }
  .ms .housing {
    stroke: var(--st);
    stroke-width: 0.9;
    transition: stroke var(--dur-fast) var(--ease-out);
  }
  .ms .window {
    fill: var(--satis-steel);
  }
  .ms .wfill,
  .ms .warn-mark {
    fill: var(--st);
  }
  .ms .wfill {
    transform-box: fill-box;
    transform-origin: left;
    transition: transform var(--dur) var(--ease-in-out);
  }
  .ms .pause {
    fill: var(--satis-ink);
  }
  .ms .cross {
    stroke: var(--satis-error);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .ms .blank {
    stroke: var(--satis-ink);
    stroke-width: 1.6;
    stroke-dasharray: 2 1.6;
  }
  .ms .light {
    fill: var(--satis-snapshot);
  }
  .ms .light.off {
    fill: var(--satis-line);
  }
  .ms-rules {
    list-style: none;
    margin: 0;
    padding: 0 12px 10px;
    display: grid;
    gap: 6px;
    font: 13px/1.4 var(--font-text);
    color: var(--satis-dim);
  }
  .ms-rules li {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 8px;
    padding: 6px 10px;
    border: 1px solid var(--satis-line);
    border-radius: 6px;
    position: relative;
    padding-right: 3.2em;
    transition:
      box-shadow var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .ms-rules li b {
    color: var(--satis-dim);
  }
  .ms-rules li.hit {
    border-color: var(--st);
    box-shadow: inset 0 0 0 1px var(--st);
    background: var(--satis-steel-2);
    color: var(--satis-ink);
  }
  .ms-rules li.hit b,
  .ms-rules li.hit .verdict {
    color: var(--st);
  }
  .ms-rules .verdict {
    position: absolute;
    top: 6px;
    right: 10px;
    font-weight: 700;
    color: var(--satis-dim);
  }
  .ms :global(.fig-ibtn),
  .ms :global(.fig-tbtn) {
    height: 44px;
    min-width: 44px;
  }
  .ms :global(.fig-ibtn) {
    width: 44px;
  }
  .ms-slider {
    order: -1;
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1 1 14rem;
    min-width: 0;
    font: 13px var(--font-text);
    color: var(--fig-ink);
  }
  .ms-slider .fig-range {
    min-width: 0;
  }
  .ms-slider span {
    flex: none;
    width: 6.5em;
  }
  /* The longest caption's lines, reserved, so the figure doesn't change height from beat to beat. */
  .ms :global(.fig-caption) {
    min-height: 3em;
  }
  @media (max-width: 40rem) {
    .ms :global(.fig-caption) {
      min-height: 4.5em;
    }
    .ms-slider {
      flex-basis: 100%;
    }
  }
  .fig-limit {
    font: 12.5px/1.5 var(--font-text);
    color: var(--fig-dim);
    background: var(--fig-bar);
    margin: 0;
    padding: 0 14px 12px;
  }
</style>
