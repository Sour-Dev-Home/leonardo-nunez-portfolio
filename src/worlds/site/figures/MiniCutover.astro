---
// A small copy of the satis cutover figure, with its areas and station icons, for the "CI's wider fonts" case. The
// API route comes down past the CLOUDFLARE label into the tunnel and on to AWS. In page px, not a viewBox: the
// miniature lays out at its real width. The CLOUDFLARE label is fixed at 80 wide (CI's fonts: 104, site-view.ts).
// On tablets the route runs 20 clear of its end until CI's fonts push the label across (#40); Fix it moves the
// route to the climb, 24 clear of even the wider label. Phones and desktops have room either way.
import Station from "../../satis/Station.astro";

interface Props {
  layout: "phone" | "tablet" | "desktop";
}
const { layout } = Astro.props;

interface Area {
  x: number;
  w: number;
  station: number;
}
const LAYOUTS: Record<Props["layout"], { pc: Area; cf: Area; aws: Area; route: string; climb?: string }> = {
  phone: {
    pc: { x: 2, w: 90, station: 47 },
    cf: { x: 98, w: 140, station: 200 },
    aws: { x: 244, w: 82, station: 285 },
    route: "M232 0 V74 H285",
  },
  tablet: {
    pc: { x: 4, w: 232, station: 120 },
    cf: { x: 252, w: 232, station: 368 },
    aws: { x: 500, w: 232, station: 616 },
    route: "M364 0 V74 H616",
    climb: "M392 0 V74 H616",
  },
  desktop: {
    pc: { x: 4, w: 408, station: 208 },
    cf: { x: 420, w: 408, station: 624 },
    aws: { x: 836, w: 408, station: 1040 },
    route: "M600 0 V74 H1040",
  },
};
const d = LAYOUTS[layout];
const AREAS = [
  ["pc", "GAMING PC", d.pc],
  ["cf", "CLOUDFLARE", d.cf],
  ["aws", "AWS", d.aws],
] as const;
---

<svg class="m-svg" data-layout={layout}>
  {AREAS.map(([z, , a]) => <rect class={`zbg zbg-${z}`} x={a.x} y="4" width={a.w} height="142" rx="10" />)}
  {
    AREAS.map(([z, name, a]) =>
      z === "cf" ? (
        <text class="zlabel zlabel-cf m-label" x={a.x + 12} y="22" textLength="80" lengthAdjust="spacingAndGlyphs">
          {name}
        </text>
      ) : (
        <text class={`zlabel zlabel-${z}`} x={a.x + 12} y="22">
          {name}
        </text>
      ),
    )
  }
  <path class="route" data-path="route" d={d.route}></path>
  {d.climb && <path class="route m-climb" data-path="climb" d={d.climb}></path>}
  <Station kind="rack" zone="pc" mode="idle" x={d.pc.station} y={74} label="Backend" sub="" />
  <Station kind="tunnel" zone="cf" x={d.cf.station} y={74} label="Tunnel" sub="api.satis-manager.com" />
  <Station kind="rack" zone="aws" x={d.aws.station} y={74} label="Backend" sub="" />
</svg>
