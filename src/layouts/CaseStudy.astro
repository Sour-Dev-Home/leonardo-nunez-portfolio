---
import Shell from "./Shell.astro";
import { StackList } from "../components/StackList";
import { ProjectLinks } from "../components/ProjectLinks";
import type { Project } from "../lib/projects";

interface Props {
  project: Project;
  slug: string;
  /** The project's world (src/worlds/), which scopes its tokens to the article. */
  world?: string;
}
const { project, slug, world } = Astro.props;
---

<Shell
  title={`${project.name} — Case Study | Leonardo Nunez`}
  description={project.summary}
  path={`/projects/${slug}`}
  image={project.ogImage}
  noteFont
>
  <main>
    <article class:list={["case-study page", world && `world-${world}`]}>
      <header class="case-study-head reveal">
        <p class="case-study-back"><a href="/">← Back to all projects</a></p>
        <p class="kicker">Case study</p>
        {/* A break point after each dot: "leonardonunez.dev" is one word, wider than a phone at this size. */}
        <h1>{project.name.split(".").map((part, i, all) => (i < all.length - 1 ? <>{part}.<wbr /></> : part))}</h1>
        <StackList stack={project.stack} />
        <ProjectLinks project={project} />
      </header>
      {/* No .reveal here: the body's first blocks stagger in on their own (motion.css). */}
      <div class="case-study-body prose"><slot /></div>
    </article>
  </main>
</Shell>
