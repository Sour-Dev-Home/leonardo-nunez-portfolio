---
import "../design/fonts.css";
import "../design/tokens.css";
import "../design/base.css";
import "../design/shell.css";
import "../design/work.css";
import "../design/prose.css";
import { Header } from "../components/Header";
import { Footer } from "../components/Footer";
import { buildMeta } from "../lib/meta";

interface Props {
  title: string;
  description: string;
  /** Root-relative path of this page, e.g. "/" or "/projects/satisfactory-dash". */
  path: string;
  image?: string;
  /** Keep this page out of search results (the 404 and kit pages). */
  noindex?: boolean;
}

const { title, description, path, image, noindex } = Astro.props;
const meta = buildMeta({ title, description, path, image }, Astro.site!);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href="/fonts/fraunces-latin-full-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/public-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{meta.title}</title>
    <link rel="canonical" href={meta.canonical} />
    {
      meta.tags.map((tag) =>
        tag.property ? (
          <meta property={tag.property} content={tag.content} />
        ) : (
          <meta name={tag.name} content={tag.content} />
        ),
      )
    }
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
