    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^30.1.3",
    "node-html-parser": "^9.0.5",
    "oxlint": "^1.89.0",
